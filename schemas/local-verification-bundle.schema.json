{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/local-verification-bundle.schema.json",
  "title": "Exact-commit local verification bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commitSha", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "checks": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "source", "check", "status", "exitCode", "artifact", "environmentIdentity"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "source": { "const": "local" },
        "check": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["passed", "failed"] },
        "exitCode": { "type": "integer", "minimum": 0 },
        "artifact": { "type": "string", "minLength": 1 },
        "environmentIdentity": { "type": "string", "minLength": 1 }
      }
    } }
  }
}
