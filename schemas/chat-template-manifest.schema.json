{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/chat-template-manifest.schema.json",
  "title": "Chat Template Manifest",
  "description": "Versioned data-only message wrapping metadata bound to an exact tokenizer identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "checksum", "tokenizerId", "tokenizerRevision", "family", "messageStart", "headerBodySeparator", "messageEnd", "messageSeparator", "toolSectionStart", "toolSectionEnd", "generationPrefix", "fixtureOnly"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "tokenizerId": { "type": "string", "minLength": 1 }, "tokenizerRevision": { "type": "string", "minLength": 1 },
    "family": { "enum": ["fixture", "canonical-v1"] }, "messageStart": { "type": "string", "minLength": 1 }, "headerBodySeparator": { "type": "string", "minLength": 1 },
    "messageEnd": { "type": "string", "minLength": 1 }, "messageSeparator": { "type": "string", "minLength": 1 }, "toolSectionStart": { "type": "string", "minLength": 1 },
    "toolSectionEnd": { "type": "string", "minLength": 1 }, "generationPrefix": { "type": "string", "minLength": 1 }, "fixtureOnly": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "family": { "const": "fixture" } }, "required": ["family"] }, "then": { "properties": { "fixtureOnly": { "const": true } } } },
    { "if": { "properties": { "family": { "const": "canonical-v1" } }, "required": ["family"] }, "then": { "properties": { "fixtureOnly": { "const": false } } } }
  ]
}
