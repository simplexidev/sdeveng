{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/verification-evidence-policy.schema.json",
  "title": "sdeveng final PR evidence policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "finalPr"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "finalPr": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredChecks", "requireLocal", "requireHosted"],
      "properties": {
        "requiredChecks": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "requireLocal": { "type": "boolean" },
        "requireHosted": { "type": "boolean" }
      }
    }
  }
}
