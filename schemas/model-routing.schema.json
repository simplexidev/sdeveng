{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdeveng model policy",
  "description": "Advisory model selection policy; it does not authorize operational mutations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cheap",
    "coding",
    "difficult",
    "exceptional",
    "unavailable",
    "policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cheap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      }
    },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      }
    },
    "difficult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      }
    },
    "exceptional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoning"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      }
    },
    "unavailable": {
      "const": "inherit-parent"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
