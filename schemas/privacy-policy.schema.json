{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdeveng privacy policy",
  "description": "Operational privacy rules for data handling, separate from ordinary toolkit settings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy", "permittedData", "prohibitedData", "externalTransmission"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "permittedData": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibitedData": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "externalTransmission": { "type": "boolean" }
  }
}
