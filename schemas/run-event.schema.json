{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/run-event.schema.json",
  "title": "sdeveng product run event v1",
  "description": "One immutable record in a product run's append-only event stream.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sequence", "occurredAt", "eventType"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": {
      "type": "string",
      "description": "Canonical lowercase UUID identifying one product run, stable across resume.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "eventType": { "enum": ["state-transition", "external-identifier-recorded", "operation-completed", "start-work-progress", "ci-check-snapshot", "ci-failure-evidence", "ci-rerun", "evidence-expansion"] },
    "expansionVersion": { "const": 1 }, "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packRevision": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "parentRequestId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])" },
    "section": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "rejection": { "enum": ["None", "MalformedRequest", "StalePack", "UnknownEvidenceId", "RecursiveExpansion", "WrongRun", "ConflictingReplay"] },
    "role": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }, "packId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "evidenceId": { "type": ["string", "null"], "pattern": "^evidence:[0-9a-f]{64}$" }, "sourceRevision": { "type": ["string", "null"], "minLength": 1 },
    "startLine": { "type": ["integer", "null"], "minimum": 1 }, "endLine": { "type": ["integer", "null"], "minimum": 1 },
    "actualBytes": { "type": "integer", "minimum": 0, "maximum": 16384 }, "actualTokens": { "type": ["integer", "null"], "minimum": 0 },
    "tokenMethod": { "enum": ["unavailable", "exact"] }, "reason": { "type": "string", "maxLength": 64 },
    "fromState": { "type": ["string", "null"], "minLength": 1 },
    "toState": { "type": "string", "minLength": 1 },
    "externalSystem": { "type": "string", "minLength": 1 },
    "identifierType": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["branch-created", "branch-pushed", "bootstrap-created", "bootstrap-cleanup", "pr-created", "pr-linked", "metadata-persisted"] },
    "progressVersion": { "const": 1 },
    "status": { "enum": ["completed", "retryable-failure", "terminal-failure", "accepted", "rejected", "omitted", "budget-exceeded"] },
    "detail": { "type": "string", "maxLength": 512 },
    "snapshotVersion": { "const": 1 },
    "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "checks": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["pending", "success", "failure", "cancelled", "skipped", "unknown"] } } } },
    "workflowRuns": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["id", "state"], "properties": { "id": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "state": { "type": "string", "minLength": 1, "maxLength": 32 } } } },
    "evidenceVersion": { "const": 1 },
    "providerRunId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "providerJobId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "failureClass": { "type": "string", "minLength": 1, "maxLength": 64 },
    "truncated": { "type": "boolean" },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 4096 }
    ,"rerunVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
    ,"rerunMode": { "enum": ["job", "failed-jobs"] },
    "rerunReason": { "type": "string", "minLength": 1, "maxLength": 256 }
    ,"failureSignature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    ,"ordinal": { "type": "integer", "minimum": 1 }
  },
  "oneOf": [
    {
      "properties": { "eventType": { "const": "state-transition" } },
      "required": ["fromState", "toState"],
      "not": { "anyOf": [{ "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }] }
    },
    {
      "properties": { "eventType": { "const": "external-identifier-recorded" } },
      "required": ["externalSystem", "identifierType", "identifier"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }] }
    },
    {
      "properties": { "eventType": { "const": "operation-completed" }, "operation": { "enum": ["branch-created", "branch-pushed"] } },
      "required": ["operation"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }, { "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }] }
    },
    {
      "properties": { "eventType": { "const": "start-work-progress" }, "status": { "enum": ["completed", "retryable-failure", "terminal-failure"] } },
      "required": ["progressVersion", "operation", "status", "detail"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }, { "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }] }
    },
    {
      "properties": { "eventType": { "const": "ci-check-snapshot" } },
      "required": ["snapshotVersion", "commitSha", "observedAt", "checks", "workflowRuns"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }, { "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }, { "required": ["detail"] }, { "required": ["operation"] }] }
    },
    {
      "properties": { "eventType": { "const": "ci-failure-evidence" }, "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" } },
      "required": ["evidenceVersion", "commitSha", "providerRunId", "providerJobId", "failureClass", "truncated", "excerpt"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }, { "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }, { "required": ["detail"] }, { "required": ["operation"] }] }
    },
    {
      "properties": { "eventType": { "const": "ci-rerun" }, "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" } },
      "required": ["rerunVersion", "repository", "commitSha", "providerRunId", "providerJobId", "rerunMode", "rerunReason", "failureSignature", "ordinal"],
      "not": { "anyOf": [{ "required": ["fromState"] }, { "required": ["toState"] }, { "required": ["externalSystem"] }, { "required": ["identifierType"] }, { "required": ["identifier"] }, { "required": ["detail"] }, { "required": ["operation"] }] }
    }
    ,{
      "properties": { "eventType": { "const": "evidence-expansion" }, "status": { "enum": ["accepted", "rejected", "omitted", "budget-exceeded"] } },
      "required": ["expansionVersion", "requestId", "role", "packId", "evidenceId", "sourceRevision", "startLine", "endLine", "actualBytes", "actualTokens", "tokenMethod", "status", "reason"]
    }
  ],
  "allOf": [
    { "if": { "properties": { "eventType": { "const": "evidence-expansion" } }, "not": { "required": ["requestDigest"] } }, "then": { "properties": { "role": { "type": "string" }, "packId": { "type": "string" }, "evidenceId": { "type": "string" }, "sourceRevision": { "type": "string" } } } },
    { "if": { "required": ["requestDigest"] }, "then": { "required": ["packRevision", "section", "parentRequestId", "rejection"], "properties": { "requestId": { "pattern": "^[A-Za-z0-9_.:-]+(?![\\s\\S])" }, "sourceRevision": { "maxLength": 128 } } } },
    { "if": { "properties": { "eventType": { "const": "external-identifier-recorded" }, "externalSystem": { "const": "github" }, "identifierType": { "const": "pull-request-number" } }, "required": ["eventType", "externalSystem", "identifierType"] }, "then": { "properties": { "identifier": { "type": "string", "pattern": "^[1-9][0-9]*$" } } } },
    { "if": { "properties": { "eventType": { "const": "external-identifier-recorded" }, "externalSystem": { "const": "github" }, "identifierType": { "const": "pull-request-url" } }, "required": ["eventType", "externalSystem", "identifierType"] }, "then": { "properties": { "identifier": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[1-9][0-9]*$" } } } }
  ]
}
