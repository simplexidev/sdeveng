{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/rendered-input-token-measurement.schema.json",
  "title": "Rendered Input Token Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "measurementKind", "tokens", "method", "templateId", "templateRevision", "templateChecksum", "tokenizerId", "tokenizerRevision", "tokenizerAssets", "fixtureOnly", "renderedInputDigest", "utf8Bytes", "unavailableReason"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "rendered-input-token-measurement" },
    "measurementKind": { "enum": ["exact", "estimated", "unavailable"] },
    "tokens": { "type": ["integer", "null"], "minimum": 0 },
    "method": { "enum": ["fixture-byte-v1", "tiktoken-v1", "ceil-utf8-bytes-div-4", null] },
    "templateId": { "type": "string", "minLength": 1 },
    "templateRevision": { "type": "string", "minLength": 1 },
    "templateChecksum": { "$ref": "#/$defs/digest" },
    "tokenizerId": { "type": ["string", "null"], "minLength": 1 },
    "tokenizerRevision": { "type": ["string", "null"], "minLength": 1 },
    "tokenizerAssets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\]+(?<!/)$" }, "sha256": { "$ref": "#/$defs/digest" } }
      }
    },
    "fixtureOnly": { "type": "boolean" },
    "renderedInputDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "utf8Bytes": { "type": ["integer", "null"], "minimum": 0 },
    "unavailableReason": { "type": ["string", "null"], "minLength": 1 },
    "attribution": { "$ref": "#/$defs/attribution" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "attribution": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "algorithm", "renderedLength", "emptyTokens", "totalTokens", "attributedTokens", "reconciled", "components"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "algorithm": { "const": "ordered-cumulative-prefix/v1" },
        "renderedLength": { "type": "integer", "minimum": 0 },
        "emptyTokens": { "const": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "attributedTokens": { "type": "integer", "minimum": 0 },
        "reconciled": { "const": true },
        "components": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["span", "prefixTokens", "tokens"],
            "properties": {
              "prefixTokens": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer" },
              "span": {
                "type": "object", "additionalProperties": false,
                "required": ["componentId", "contentReference", "start", "length"],
                "properties": {
                  "componentId": { "enum": ["system", "role", "skill-metadata", "skill-instructions", "skill-references", "request", "evidence", "state", "tools", "output-contract", "chat-template-overhead"] },
                  "contentReference": { "type": "string", "minLength": 1 },
                  "start": { "type": "integer", "minimum": 0 },
                  "length": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "required": ["attribution"] }, "then": { "properties": { "measurementKind": { "const": "exact" } } } },
    {
      "if": { "properties": { "measurementKind": { "const": "unavailable" } } },
      "then": { "properties": { "tokens": { "type": "null" }, "method": { "type": "null" }, "unavailableReason": { "type": "string" } } },
      "else": { "properties": { "tokens": { "type": "integer" }, "renderedInputDigest": { "$ref": "#/$defs/digest" }, "utf8Bytes": { "type": "integer" }, "tokenizerId": { "type": "string" }, "unavailableReason": { "type": "null" } } }
    },
    { "if": { "properties": { "measurementKind": { "const": "exact" } } }, "then": { "oneOf": [
      { "properties": { "method": { "const": "fixture-byte-v1" }, "fixtureOnly": { "const": true } } },
      { "properties": { "method": { "const": "tiktoken-v1" }, "fixtureOnly": { "const": false } } }
    ] } },
    { "if": { "properties": { "measurementKind": { "const": "estimated" } } }, "then": { "properties": { "method": { "const": "ceil-utf8-bytes-div-4" } } } },
    {
      "if": { "properties": { "tokenizerId": { "type": "null" } } },
      "then": { "properties": { "tokenizerRevision": { "type": "null" }, "tokenizerAssets": { "maxItems": 0 } } },
      "else": { "properties": { "tokenizerRevision": { "type": "string" }, "tokenizerAssets": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "renderedInputDigest": { "type": "null" } } },
      "then": { "properties": { "utf8Bytes": { "type": "null" } } },
      "else": { "properties": { "utf8Bytes": { "type": "integer" } } }
    }
  ]
}
