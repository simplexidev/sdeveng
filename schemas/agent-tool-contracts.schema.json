{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdeveng structured output contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "cli", "cliVersion", "resultSchema", "resultSchemaVersion", "exitCodes", "legacyInvocations", "contracts"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 2 },
    "cli": { "const": "sdeveng" },
    "cliVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "resultSchema": { "const": "../schemas/cli-result.schema.json" },
    "resultSchemaVersion": { "const": 1 },
    "exitCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "commandOutcome", "invalidInvocation", "requiredDependencyUnavailable", "internalError"],
      "properties": {
        "success": { "const": 0 },
        "commandOutcome": { "const": 1 },
        "invalidInvocation": { "const": 2 },
        "requiredDependencyUnavailable": { "const": 3 },
        "internalError": { "const": 70 }
      }
    },
    "legacyInvocations": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "kind", "schemaVersion", "mode"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "mode": { "enum": ["facts", "plan", "summary"] }
        }
      }
    }
  }
}
