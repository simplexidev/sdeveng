{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Agent Plugins manifest contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "description", "author", "homepage", "repository", "license", "keywords", "extensions"],
  "properties": {
    "$schema": { "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json" },
    "name": { "const": "sdeveng-engineering-toolkit" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "const": "SimplexiDev Engineering Toolkit" },
        "url": { "const": "https://github.com/simplexidev" }
      }
    },
    "homepage": { "const": "https://github.com/simplexidev/sdeveng" },
    "repository": { "const": "https://github.com/simplexidev/sdeveng" },
    "license": { "const": "MIT" },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["com.openai"],
      "properties": {
        "com.openai": { "$ref": "#/$defs/openaiExtension" }
      }
    }
  },
  "$defs": {
    "openaiExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface"],
      "properties": { "interface": { "$ref": "#/$defs/interface" } }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "shortDescription", "longDescription", "developerName", "category", "capabilities", "defaultPrompt"],
      "properties": {
        "displayName": { "const": "SimplexiDev Engineering Toolkit" },
        "shortDescription": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string", "minLength": 1 },
        "developerName": { "const": "SimplexiDev Engineering Toolkit" },
        "category": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array" },
        "defaultPrompt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
