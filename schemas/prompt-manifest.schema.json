{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/prompt-manifest.schema.json",
  "title": "Prompt Manifest",
  "description": "Versioned ordered components used to construct a worker input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "system" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "role" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "request" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "output-contract" } }, "required": ["id"] }, "minContains": 1 }
      ],
      "uniqueItems": true
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provenance", "contentReference", "contentHash"],
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "request" } }, "required": ["id"] },
          "then": {
            "dependentRequired": {
              "requestContentKind": ["requestProjection", "originalArtifactReference"],
              "requestProjection": ["requestContentKind", "originalArtifactReference"],
              "originalArtifactReference": ["requestContentKind", "requestProjection"]
            }
          },
          "else": {
            "not": { "anyOf": [
              { "required": ["requestContentKind"] },
              { "required": ["requestProjection"] },
              { "required": ["originalArtifactReference"] }
            ] }
          }
        },
        {
          "if": { "properties": { "id": { "const": "evidence" } }, "required": ["id"] },
          "then": {
            "dependentRequired": { "evidenceReferenceKind": ["evidenceItemId"], "evidenceItemId": ["evidenceReferenceKind"] }
          },
          "else": { "not": { "anyOf": [{ "required": ["evidenceReferenceKind"] }, { "required": ["evidenceItemId"] }] } }
        },
        {
          "if": { "properties": { "id": { "const": "state" } }, "required": ["id"] },
          "else": { "not": { "required": ["stateContentKind"] } }
        },
        {
          "if": { "properties": { "id": { "const": "tools" } }, "required": ["id"] },
          "then": { "not": { "required": ["responseSchema"] } },
          "else": { "not": { "required": ["tools"] } }
        },
        {
          "if": { "properties": { "id": { "const": "output-contract" } }, "required": ["id"] },
          "then": { "required": ["responseSchema"] },
          "else": { "not": { "required": ["responseSchema"] } }
        }
      ],
      "properties": {
        "id": { "enum": ["system", "role", "skill-metadata", "skill-instructions", "skill-references", "request", "evidence", "state", "tools", "output-contract"] },
        "role": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "contentReference": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "isLoaded": { "type": "boolean", "default": true },
        "requestContentKind": { "enum": ["text", "fact-mapping"] },
        "requestProjection": { "enum": ["original", "normalized", "condensed"] },
        "originalArtifactReference": { "type": "string", "minLength": 1 },
        "evidenceReferenceKind": { "const": "evidence-pack-item" },
        "evidenceItemId": { "type": "string", "pattern": "^evidence:[0-9a-f]{64}$" },
        "stateContentKind": { "enum": ["run-facts", "work-unit-facts", "synthetic-placeholder"] },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" }, "uniqueItems": true },
        "responseSchema": { "type": "string", "minLength": 1 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "schemaReference", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "schemaReference": { "type": "string", "minLength": 1 },
        "type": { "const": "function" }
      }
    }
  }
}
