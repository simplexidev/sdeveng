{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/prompt-manifest.schema.json",
  "title": "Prompt Manifest",
  "description": "Versioned ordered components used to construct a worker input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "system" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "role" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "request" } }, "required": ["id"] }, "minContains": 1 },
        { "contains": { "properties": { "id": { "const": "output-contract" } }, "required": ["id"] }, "minContains": 1 }
      ],
      "uniqueItems": true
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "provenance", "contentReference", "contentHash"],
      "properties": {
        "id": { "enum": ["system", "role", "skill-metadata", "skill-instructions", "skill-references", "request", "evidence", "state", "tools", "output-contract"] },
        "role": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 },
        "contentReference": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 }
      }
    }
  }
}
