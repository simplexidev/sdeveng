{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill identity metadata",
  "description": "Optional additive SKILL.md front matter fields. Legacy name and description front matter remains supported.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "dependentRequired": {
    "id": [
      "version"
    ],
    "version": [
      "id"
    ]
  }
}
