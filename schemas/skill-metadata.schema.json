{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.dev/schemas/skill-metadata.schema.json",
  "title": "Skill metadata",
  "description": "Optional additive SKILL.md front matter fields. Legacy name and description front matter remains supported.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "activation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "frameworkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
        }
      }
    },
    "supportedRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["planner", "coder", "test-author", "reviewer", "repair"]
      }
    },
    "requiredTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "contextAllowance": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" },
      "uniqueItems": true
    },
    "safety": { "$ref": "#/$defs/facts" },
    "requiredFacts": { "$ref": "#/$defs/facts" },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" },
      "uniqueItems": true
    }
  },
  "dependentRequired": {
    "id": [
      "version"
    ],
    "version": [
      "id"
    ]
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelFamily", "modelRevision", "role", "skillVersion", "body", "safety", "requiredTools", "requiredFacts", "qualification"],
      "properties": {
        "modelFamily": { "type": "string", "minLength": 1 },
        "modelRevision": { "type": "string", "minLength": 1 },
        "role": { "enum": ["planner", "coder", "test-author", "reviewer", "repair"] },
        "skillVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "body": { "type": "string", "minLength": 1 },
        "safety": { "$ref": "#/$defs/facts" },
        "requiredTools": { "$ref": "#/$defs/facts" },
        "requiredFacts": { "$ref": "#/$defs/facts" },
        "qualification": { "$ref": "#/$defs/qualification" }
      }
    },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelFamily", "modelRevision", "role", "skillVersion", "passed", "tokensSaved", "tokenizerId", "tokenizerRevision", "templateId", "templateRevision", "safety", "requiredTools", "requiredFacts"],
      "properties": {
        "modelFamily": { "type": "string", "minLength": 1 },
        "modelRevision": { "type": "string", "minLength": 1 },
        "role": { "enum": ["planner", "coder", "test-author", "reviewer", "repair"] },
        "skillVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "passed": { "type": "boolean" },
        "tokensSaved": { "type": "integer", "minimum": 0 },
        "tokenizerId": { "type": "string", "minLength": 1 },
        "tokenizerRevision": { "type": "string", "minLength": 1 },
        "templateId": { "type": "string", "minLength": 1 },
        "templateRevision": { "type": "string", "minLength": 1 },
        "safety": { "$ref": "#/$defs/facts" },
        "requiredTools": { "$ref": "#/$defs/facts" },
        "requiredFacts": { "$ref": "#/$defs/facts" }
      }
    }
  }
}
