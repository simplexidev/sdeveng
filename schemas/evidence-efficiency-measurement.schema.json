{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/evidence-efficiency-measurement.schema.json",
  "title": "Evidence Efficiency Measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidates", "selected", "candidateFileCount", "selectedFileCount", "candidateSymbolCount", "selectedSymbolCount", "candidateBytes", "candidateTokens", "selectedBytes", "selectedTokens", "selectionRatio", "selectionRatioUnavailableReason", "role", "roleInputBudgetTokens", "renderedInputTokens", "utilizationPercent", "utilizationUnavailableReason", "truncationEvents", "overflowEvents"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "evidence-efficiency-measurement" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "selected": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "candidateFileCount": { "type": "integer", "minimum": 0 },
    "selectedFileCount": { "type": "integer", "minimum": 0 },
    "candidateSymbolCount": { "type": "integer", "minimum": 0 },
    "selectedSymbolCount": { "type": "integer", "minimum": 0 },
    "candidateBytes": { "type": "integer", "minimum": 0 },
    "candidateTokens": { "type": ["integer", "null"], "minimum": 0 },
    "selectedBytes": { "type": "integer", "minimum": 0 },
    "selectedTokens": { "type": ["integer", "null"], "minimum": 0 },
    "selectionRatio": { "type": ["number", "null"], "minimum": 0 },
    "selectionRatioUnavailableReason": { "type": ["string", "null"], "enum": ["candidate-tokens-zero", "token-measurement-unavailable", null] },
    "role": { "type": "string", "minLength": 1 },
    "roleInputBudgetTokens": { "type": "integer", "minimum": 0 },
    "renderedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "utilizationPercent": { "type": ["number", "null"], "minimum": 0 },
    "utilizationUnavailableReason": { "type": ["string", "null"], "enum": ["role-input-budget-zero", "rendered-input-tokens-unavailable", null] },
    "truncationEvents": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "overflowEvents": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "evidenceId", "sourceRevision", "reason", "originalBytes", "resultBytes", "originalTokens", "resultTokens"],
      "properties": {
        "eventType": { "enum": ["truncation", "overflow"] },
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "originalBytes": { "type": "integer", "minimum": 0 },
        "resultBytes": { "type": "integer", "minimum": 0 },
        "originalTokens": { "type": ["integer", "null"], "minimum": 0 },
        "resultTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceRevision", "text", "utf8Bytes", "tokens", "fileLocationKey", "symbolLocationKey"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "utf8Bytes": { "type": ["integer", "null"], "minimum": 0 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 },
        "fileLocationKey": { "type": ["string", "null"], "minLength": 1 },
        "symbolLocationKey": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
