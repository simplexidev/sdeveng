{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Console and command-line detector fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outputType", "source", "packageVersions", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "outputType": { "type": "string", "enum": ["Exe"] },
          "source": { "type": "string", "minLength": 1 },
          "packageVersions": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
          "expected": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "enum": ["detected", "absent", "unknown"] } },
          "expectedCommandLineSkillActivation": { "type": "boolean" }
        }
      }
    }
  }
}
