{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ecosystem-contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "productId",
    "productName",
    "productRepository",
    "humanDocumentationRepository",
    "metricsRepository",
    "metricsPagesUrl",
    "productVersionLine",
    "integrationBranch",
    "repositoryRoles",
    "pluginPath",
    "templatePath",
    "siblingRepositoriesAreRuntimeDependencies",
    "agentRuntimeReferencesOwner"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "productId": { "const": "sdeveng" },
    "productName": { "const": "SimplexiDev Engineering Toolkit" },
    "productRepository": { "const": "simplexidev/codex-toolkit" },
    "humanDocumentationRepository": { "const": "simplexidev/codex-toolkit-docs" },
    "metricsRepository": { "const": "simplexidev/codex-toolkit-metrics" },
    "metricsPagesUrl": { "const": "https://simplexidev.github.io/codex-toolkit-metrics/" },
    "productVersionLine": { "const": "3.0.0" },
    "integrationBranch": { "const": "develop/v3.0.0" },
    "repositoryRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "documentation", "metricsTooling", "metricsData", "metricsDashboard"],
      "properties": {
        "product": { "const": "sdeveng" },
        "documentation": { "const": "sdeveng-docs" },
        "metricsTooling": { "const": "sdeveng-metrics-tooling" },
        "metricsData": { "const": "sdeveng-metrics-data" },
        "metricsDashboard": { "const": "sdeveng-metrics-dashboard" }
      }
    },
    "pluginPath": { "const": "plugins/sdeveng" },
    "templatePath": { "const": "templates/project" },
    "siblingRepositoriesAreRuntimeDependencies": { "const": false },
    "agentRuntimeReferencesOwner": { "const": "product" }
  }
}
