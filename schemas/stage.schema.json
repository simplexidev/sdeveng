{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/sdeveng/schemas/stage.schema.json",
  "title": "sdeveng roadmap stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "goal", "executionMode", "labels", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^stage-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "executionMode": { "enum": ["change", "operation"] },
    "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "title", "acceptanceTarget", "reviewGate"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "acceptanceTarget": { "type": "string", "minLength": 1 },
          "reviewGate": { "enum": ["none", "required"] }
        }
      }
    }
  }
}
