{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdeveng agent audit and metrics candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "owner", "asOf", "detectedSystem", "policy", "evidence", "builtInRoles", "toolkitRoles", "candidateRoles", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "owner": { "const": "simplexidev/sdeveng" },
    "asOf": { "type": "string", "format": "date" },
    "detectedSystem": { "$ref": "#/$defs/detectedSystem" },
    "policy": { "$ref": "#/$defs/policy" },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "builtInRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } },
    "toolkitRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } },
    "candidateRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "detectedSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cliVersion", "multiAgentFeature", "multiAgentV2Feature", "roleSelectionInActiveSpawnSurface", "customRoleFileParsing", "customRoleDirectory", "concurrencySetting", "notes"],
      "properties": {
        "cliVersion": { "type": "string", "minLength": 1 },
        "multiAgentFeature": { "enum": ["enabled", "disabled", "unknown"] },
        "multiAgentV2Feature": { "enum": ["enabled", "disabled", "unknown"] },
        "roleSelectionInActiveSpawnSurface": { "type": "boolean" },
        "customRoleFileParsing": { "enum": ["accepted", "rejected", "not-tested"] },
        "customRoleDirectory": { "type": "string", "minLength": 1 },
        "concurrencySetting": { "type": "string", "minLength": 1 },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "productionChanges", "runtimeDefaultExclusions", "decisionVocabulary", "delegation"],
      "properties": {
        "hierarchy": { "const": ["deterministic", "jev", "agent", "stronger-agent"] },
        "productionChanges": { "const": "none" },
        "runtimeDefaultExclusions": { "type": "array", "contains": { "const": "eval-judge" } },
        "delegation": { "const": "root-only; delegated agents must not delegate" },
        "decisionVocabulary": {
          "const": ["KEEP", "MODIFY", "RETIRE", "REPLACE_WITH_BUILTIN", "EVALUATE_FOR_ADD", "INSUFFICIENT_EVIDENCE"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "supports"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["installed-cli", "runtime-surface", "repository", "git-history", "official-docs", "metrics"] },
        "locator": { "type": "string", "minLength": 1 },
        "supports": { "$ref": "#/$defs/stringArray" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reasoning", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 },
        "source": { "enum": ["fixed", "inherits-parent", "candidate"] }
      }
    },
    "staticCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "metadata", "invocation", "contextIsolation"],
      "properties": {
        "trigger": { "enum": ["session-root", "explicit-delegation", "explicit-or-high-risk", "conditional", "not-active"] },
        "metadata": { "enum": ["none", "low", "unknown"] },
        "invocation": { "enum": ["none", "separate-model-turn", "unknown"] },
        "contextIsolation": { "enum": ["none", "low", "medium", "high", "unknown"] }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callers", "inputs", "outputs"],
      "properties": {
        "callers": { "$ref": "#/$defs/stringArray" },
        "inputs": { "$ref": "#/$defs/stringArray" },
        "outputs": { "$ref": "#/$defs/stringArray" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "tools", "mcp", "skills"],
      "properties": {
        "sandbox": { "type": "string", "minLength": 1 },
        "tools": { "$ref": "#/$defs/stringArray" },
        "mcp": { "$ref": "#/$defs/stringArray" },
        "skills": { "$ref": "#/$defs/stringArray" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "lifecycle", "availability", "purpose", "disposition", "rationale", "evidence", "model", "staticCost", "capabilities", "interface", "overlap", "isolationValue"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "class": { "enum": ["built-in", "toolkit-custom", "candidate"] },
        "lifecycle": { "enum": ["current", "historical-retired", "proposed", "conditional-comparator"] },
        "availability": { "enum": ["available", "repository-only", "not-exposed", "not-implemented"] },
        "purpose": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["KEEP", "MODIFY", "RETIRE", "REPLACE_WITH_BUILTIN", "EVALUATE_FOR_ADD", "INSUFFICIENT_EVIDENCE"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "model": { "$ref": "#/$defs/model" },
        "staticCost": { "$ref": "#/$defs/staticCost" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "interface": { "$ref": "#/$defs/interface" },
        "overlap": { "$ref": "#/$defs/stringArray" },
        "isolationValue": { "type": "string", "minLength": 1 }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "availabilityGate", "configuration"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string", "minLength": 1 },
        "availabilityGate": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "fixtures", "arms", "requiredMeasurements", "successCriteria", "safetyConstraints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "question": { "type": "string", "minLength": 1 },
        "fixtures": { "$ref": "#/$defs/stringArray" },
        "arms": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/arm" } },
        "requiredMeasurements": { "$ref": "#/$defs/stringArray" },
        "successCriteria": { "$ref": "#/$defs/stringArray" },
        "safetyConstraints": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
