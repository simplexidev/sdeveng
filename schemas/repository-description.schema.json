{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repository-description",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "root", "repositoryConfigurationFiles", "repositoryConfigurationFileCount", "repositoryConfigurationFilesTruncated", "catalogFingerprint", "projects", "projectCount", "projectsTruncated", "graph", "trackedFiles", "trackedFileCount", "trackedFilesTruncated"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "repository-description" },
    "root": { "type": "string", "minLength": 1 },
    "repositoryConfigurationFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "repositoryConfigurationFileCount": { "type": "integer", "minimum": 0 },
    "repositoryConfigurationFilesTruncated": { "type": "boolean" },
    "catalogFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "kind", "targetFrameworks", "ownedFiles", "projectReferences", "packageReferences"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "language": { "enum": ["C#", "F#", "Visual Basic"] },
          "kind": { "enum": ["application", "library", "test"] },
          "frameworkCapabilities": {
            "type": "array", "minItems": 4, "maxItems": 24, "uniqueItems": true,
            "allOf": [
              { "contains": { "properties": { "id": { "const": "plain-console" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "generic-host-console" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "console-redirection" } }, "required": ["id"] } },
              { "contains": { "properties": { "id": { "const": "system-commandline" } }, "required": ["id"] } }
            ],
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": { "enum": ["plain-console", "generic-host-console", "console-redirection", "system-commandline", "channels", "localization", "generic-host", "dependency-injection", "configuration", "options", "logging", "background-service", "hosted-service", "http-client-factory", "http-client-typed", "http-client-named", "http-client-resilience", "memory-cache", "distributed-cache", "microsoft-extensions-telemetry", "opentelemetry", "telemetry-logging", "telemetry-tracing", "telemetry-metrics"] },
                "status": { "enum": ["detected", "absent", "unknown"] },
                "evidence": { "type": "string", "minLength": 1 },
                "version": { "type": ["string", "null"] },
                "locations": { "type": ["array", "null"], "maxItems": 64, "items": {
                  "type": "object", "additionalProperties": false, "required": ["path", "line", "column"],
                  "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } }
                } }
              }
            }
          },
          "targetFrameworks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "ownedFiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "projectReferences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "packageReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": { "id": { "type": ["string", "null"] }, "version": { "type": ["string", "null"] } }
            }
          }
        }
      }
    },
    "projectCount": { "type": "integer", "minimum": 0 },
    "projectsTruncated": { "type": "boolean" },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "validation"],
      "properties": {
        "nodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "edges": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } } } },
        "validation": { "type": "object", "additionalProperties": false, "required": ["isValid", "cycles", "unresolvedEdges"], "properties": { "isValid": { "type": "boolean" }, "cycles": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "unresolvedEdges": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } } } } } }
      }
    },
    "trackedFiles": { "type": "array", "items": { "type": "string" } },
    "trackedFileCount": { "type": "integer", "minimum": 0 },
    "trackedFilesTruncated": { "type": "boolean" }
  }
}
