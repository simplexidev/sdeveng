{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static framework capability facts",
  "type": "array",
  "minItems": 4,
  "maxItems": 19,
  "allOf": [
    { "contains": { "properties": { "id": { "const": "plain-console" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "generic-host-console" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "console-redirection" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "system-commandline" } }, "required": ["id"] } }
  ],
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "status", "evidence"],
    "properties": {
      "id": { "enum": ["plain-console", "generic-host-console", "console-redirection", "system-commandline", "generic-host", "dependency-injection", "configuration", "options", "logging", "background-service", "hosted-service", "http-client-factory", "http-client-typed", "http-client-named", "http-client-resilience", "memory-cache", "distributed-cache", "microsoft-extensions-telemetry", "opentelemetry"] },
      "status": { "enum": ["detected", "absent", "unknown"] },
      "evidence": { "type": "string", "minLength": 1 },
      "version": { "type": ["string", "null"] },
      "locations": { "type": ["array", "null"], "maxItems": 64, "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "line", "column"],
        "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } }
      } }
    }
  },
  "uniqueItems": true
}
