{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static framework capability facts",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "allOf": [
    { "contains": { "properties": { "id": { "const": "plain-console" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "generic-host-console" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "console-redirection" } }, "required": ["id"] } },
    { "contains": { "properties": { "id": { "const": "system-commandline" } }, "required": ["id"] } }
  ],
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "status", "evidence"],
    "properties": {
      "id": { "enum": ["plain-console", "generic-host-console", "console-redirection", "system-commandline"] },
      "status": { "enum": ["detected", "absent", "unknown"] },
      "evidence": { "type": "string", "minLength": 1 },
      "version": { "type": ["string", "null"] }
    }
  },
  "uniqueItems": true
}
