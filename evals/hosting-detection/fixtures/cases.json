    {
      "id": "registered-cancellable-worker",
      "source": "using Microsoft.Extensions.DependencyInjection; var b = Microsoft.Extensions.Hosting.Host.CreateApplicationBuilder(); b.Services.AddHostedService<Worker>(); class Worker : Microsoft.Extensions.Hosting.BackgroundService { protected override System.Threading.Tasks.Task ExecuteAsync(System.Threading.CancellationToken stoppingToken) => System.Threading.Tasks.Task.Delay(-1, stoppingToken); }",
      "packageVersions": {},
      "expected": { "generic-host": "detected", "dependency-injection": "absent", "configuration": "absent", "options": "absent", "logging": "absent", "background-service": "detected", "hosted-service": "detected" },
      "expectedLocations": { "generic-host": 1, "background-service": 1, "hosted-service": 1 }
    },
    {
      "id": "registered-interface-shutdown-defect",
      "source": "using Microsoft.Extensions.DependencyInjection; var s = new ServiceCollection(); s.AddSingleton<Microsoft.Extensions.Hosting.IHostedService, Service>(); class Service : Microsoft.Extensions.Hosting.IHostedService { public System.Threading.Tasks.Task StartAsync(System.Threading.CancellationToken token) => System.Threading.Tasks.Task.CompletedTask; public System.Threading.Tasks.Task StopAsync(System.Threading.CancellationToken token) => System.Threading.Tasks.Task.Delay(-1); }",
      "packageVersions": {},
      "expected": { "generic-host": "absent", "dependency-injection": "detected", "configuration": "absent", "options": "absent", "logging": "absent", "background-service": "absent", "hosted-service": "detected" },
      "expectedLocations": { "dependency-injection": 1, "hosted-service": 1 }
    },
